{
  "name": "psycgod-sage",
  "version": "2.6.1",
  "mcpName": "io.github.PsYcGoD/sage",
  "mcpName": "io.github.PsYcGoD/sage",
  "description": "npm/npx launcher for the canonical PyPI SAGE CLI wrapper for AI coding agents",
  "author": "PsYcGoD",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sage": "bin/sage.js"
  },
  "files": [
    "bin",
    "dist/index.*",
    "dist/cli/index.*",
    "dist/python/bridge.*"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "test": "vitest --run tests/launcher.test.ts",
    "lint": "eslint src",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PsYcGoD/sage.git"
  },
  "keywords": [
    "ai",
    "cli",
    "terminal",
    "compression",
    "mcp",
    "claude",
    "coding-agent",
    "developer-tools"
  ]
}
